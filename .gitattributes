# LF in the repository regardless of the committing OS, so Windows and Linux
# checkouts never produce whole-file diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff or normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.pptx binary
*.hwp binary
*.zip binary

# Lockfile: generated, collapse in diffs.
package-lock.json -diff linguist-generated